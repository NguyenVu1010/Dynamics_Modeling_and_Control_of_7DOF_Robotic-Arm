/* Project rules of cobot_studio, applied after the Breeze light sheet (studio config UI design
 * 3.5). The widgets opt in through dynamic properties: card, changed, primary, hint, keyName,
 * switch (a bool switch, ParamCard). */

QFrame[card="true"]
{
    background-color: #ffffff;
    border: 1px solid #e3e6eb;
    border-radius: 7px;
    padding: 10px;
}

/* Breeze paints every widget with the window grey: inside a card, labels, check boxes and the
 * layout containers take the card's white, and the editors a white field. */
QFrame[card="true"] QLabel,
QFrame[card="true"] QCheckBox,
QFrame[card="true"] QToolButton,
QFrame[card="true"] QWidget#joints,
QFrame[card="true"] QWidget#jointCell
{
    background-color: transparent;
}

/* Segmented buttons (noise level): white segments, the checked one in the accent blue. */
QFrame#noiseLevel QToolButton
{
    background-color: #ffffff;
    border: 1px solid #c8cdd6;
    padding: 3px 14px;
}

QFrame#noiseLevel QToolButton:checked,
QFrame[card="true"] QToolButton:checked
{
    background-color: #dbeafe;
    border: 1px solid #2563eb;
    color: #1d4ed8;
}

QFrame[card="true"] QAbstractSpinBox,
QFrame[card="true"] QLineEdit,
QFrame[card="true"] QComboBox
{
    background-color: #ffffff;
}

/* Typed fields: the step arrows take no room (ParamSpin also hides them). */
QFrame[card="true"] QAbstractSpinBox::up-button,
QFrame[card="true"] QAbstractSpinBox::down-button
{
    width: 0px;
    border: none;
}

QFrame[card="true"] QAbstractSpinBox::up-arrow,
QFrame[card="true"] QAbstractSpinBox::down-arrow
{
    image: none;
    width: 0px;
    height: 0px;
}

QFrame[card="true"] QAbstractSpinBox[changed="true"],
QFrame[card="true"] QLineEdit[changed="true"],
QFrame[card="true"] QComboBox[changed="true"],
QAbstractSpinBox[changed="true"],
QLineEdit[changed="true"],
QComboBox[changed="true"]
{
    background-color: #fff4d6;
    border: 1px solid #f0c24b;
    font-weight: bold;
}

QPushButton[primary="true"]
{
    background-color: #2563eb;
    border: 1px solid #2563eb;
    color: #ffffff;
    font-weight: bold;
}

QPushButton[primary="true"]:disabled
{
    background-color: #eff0f1;
    border: 1px solid #bab9b8;
    color: #bab9b8;
}

QLabel[hint="true"]
{
    color: #6b7385;
    font-size: 11px;
}

QLabel[keyName="true"]
{
    color: #a0a6b2;
    font-family: monospace;
    font-size: 10px;
}

QListWidget#groupList
{
    background-color: #ffffff;
    border: 1px solid #e3e6eb;
    border-radius: 7px;
    outline: none;
}

QListWidget#groupList::item
{
    padding: 6px 12px;
}

QListWidget#groupList::item:selected
{
    background-color: #eaf1ff;
    color: #1d4ed8;
}

QFrame[card="true"] QToolButton[switch="true"]
{
    min-width: 36px;
    border: 1px solid #bab9b8;
    border-radius: 9px;
    padding: 2px 8px;
}

QFrame[card="true"] QToolButton[switch="true"]:checked
{
    background-color: #2563eb;
    border: 1px solid #2563eb;
    color: #ffffff;
}
