Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: cobot_gui/WaypointPanel
    Name: Waypoints
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Enabled: true
      Name: Grid
      Reference Frame: <Fixed Frame>
    - Class: rviz_default_plugins/RobotModel
      Description Source: Topic
      Description Topic:
        Value: /robot_description
      Enabled: true
      Name: RobotModel
    - Class: rviz_default_plugins/TF
      Enabled: true
      Name: TF
    - Class: rviz_default_plugins/InteractiveMarkers
      Enabled: true
      Interactive Markers Namespace: /cobot_waypoints
      Name: Waypoints
      Show Axes: false
      Show Descriptions: true
    - Class: rviz_default_plugins/Path
      Color: 255; 170; 0
      Enabled: true
      Name: Preview path
      Topic:
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /rviz/preview_path
    - Class: rviz_default_plugins/Path
      Color: 0; 200; 0
      Enabled: true
      Name: Reference path
      Topic:
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /cobot_controller/reference_path
  Enabled: true
  Global Options:
    Fixed Frame: base_link
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 3.0
      Focal Point:
        X: 0.0
        Y: 0.0
        Z: 0.5
      Name: Current View
      Pitch: 0.5
      Yaw: 0.8
Window Geometry:
  Displays:
    collapsed: false
  Height: 900
  Waypoints:
    collapsed: false
  Width: 1500
