---
BasedOnStyle: Google
Language: Cpp
Standard: c++17
ColumnLimit: 100
IndentWidth: 2
AccessModifierOffset: -1
DerivePointerAlignment: false
PointerAlignment: Left
AllowShortFunctionsOnASingleLine: Inline
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
BinPackArguments: false
BinPackParameters: false
BreakBeforeBraces: Attach
IncludeBlocks: Regroup
IncludeCategories:
  # C and C++ standard headers, POSIX system headers (sys/...)
  - Regex: '^<(sys/)?[a-z_]+(\.h)?>$'
    Priority: 1
  # Third-party libraries
  - Regex: '^<(ament_index_cpp|Eigen|sophus|gtsam|pcl|yaml-cpp|gtest|rclcpp|sensor_msgs|nav_msgs|geometry_msgs)/'
    Priority: 2
  # Project headers
  - Regex: '^"cobot/'
    Priority: 3
  - Regex: '.*'
    Priority: 4
SortIncludes: CaseSensitive
...
