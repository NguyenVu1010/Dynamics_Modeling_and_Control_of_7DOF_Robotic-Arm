<?xml version="1.0"?>
<robot name="bad">
  <link name="base_link" />
  <joint name="slider" type="prismatic">
    <origin xyz="0 0 0" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="link_1" />
    <axis xyz="1 0 0" />
    <limit lower="0" upper="0.5" effort="10" velocity="1" />
  </joint>
  <link name="link_1">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="1" />
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001" />
    </inertial>
  </link>
</robot>
