<?xml version="1.0"?>
<!-- base_link -base_fix-> plate -joint_1-> link_1 -joint_2-> link_2.
     plate is fixed before the first revolute joint: it belongs to the base and is dropped.
     link_1 carries a moving side branch finger_joint -> finger -finger_fix-> finger_pad: it is
     not on the base -> tip path and is ignored (see test_model_branches.cpp). -->
<robot name="base_fixed_side_branch">
  <link name="base_link" />
  <joint name="base_fix" type="fixed">
    <origin xyz="0 0 0.2" rpy="0 0 0.5" />
    <parent link="base_link" />
    <child link="plate" />
  </joint>
  <link name="plate">
    <inertial>
      <origin xyz="0 0 0.01" rpy="0 0 0" />
      <mass value="5.0" />
      <inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.1" />
    </inertial>
  </link>
  <joint name="joint_1" type="revolute">
    <origin xyz="0.1 0 0.05" rpy="0 0 0" />
    <parent link="plate" />
    <child link="link_1" />
    <axis xyz="0 0 1" />
    <limit lower="-1" upper="1" effort="20" velocity="1" />
  </joint>
  <link name="link_1">
    <inertial>
      <origin xyz="0.1 0 0" rpy="0 0 0" />
      <mass value="2.0" />
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.02" iyz="0" izz="0.03" />
    </inertial>
  </link>
  <joint name="finger_joint" type="revolute">
    <origin xyz="0 0.2 0" rpy="0 0 0" />
    <parent link="link_1" />
    <child link="finger" />
    <axis xyz="1 0 0" />
    <limit lower="-1" upper="1" effort="5" velocity="1" />
  </joint>
  <link name="finger">
    <inertial>
      <origin xyz="0 0.05 0" rpy="0 0 0" />
      <mass value="0.7" />
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001" />
    </inertial>
  </link>
  <joint name="finger_fix" type="fixed">
    <origin xyz="0 0.1 0" rpy="0 0 0" />
    <parent link="finger" />
    <child link="finger_pad" />
  </joint>
  <link name="finger_pad">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.3" />
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001" />
    </inertial>
  </link>
  <joint name="joint_2" type="revolute">
    <origin xyz="0.4 0 0" rpy="0 0 0" />
    <parent link="link_1" />
    <child link="link_2" />
    <axis xyz="0 1 0" />
    <limit lower="-1" upper="1" effort="20" velocity="1" />
  </joint>
  <link name="link_2">
    <inertial>
      <origin xyz="0.2 0 0" rpy="0 0 0" />
      <mass value="1.0" />
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.004" iyz="0" izz="0.004" />
    </inertial>
  </link>
</robot>
