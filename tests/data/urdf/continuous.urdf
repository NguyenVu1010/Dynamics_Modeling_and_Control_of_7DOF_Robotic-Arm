<?xml version="1.0"?>
<robot name="continuous">
  <link name="base_link" />
  <joint name="wheel_joint" type="continuous">
    <origin xyz="0 0 0" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="wheel" />
    <axis xyz="1 0 0" />
    <limit effort="4" velocity="6" />
  </joint>
  <link name="wheel">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.3" />
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001" />
    </inertial>
  </link>
</robot>
